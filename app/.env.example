# =====================================================================
# Copie para .env.local e preencha. Nunca versione o .env.local.
# =====================================================================

# ---- Supabase ----
# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A service_role IGNORA o RLS: é ela que permite ao webhook ativar a licença
# de alguém sem estar logado como a pessoa. Só no servidor. Se vazar, quem
# tiver a chave lê e escreve o banco inteiro. Nunca use o prefixo
# NEXT_PUBLIC_ aqui — ele publicaria a chave no bundle do navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Mercado Pago ----
# Painel do Mercado Pago > Suas integrações > sua aplicação > Credenciais.
# Use as de TESTE enquanto valida; troque pelas de produção ao lançar.
MP_ACCESS_TOKEN=

# Gerado ao cadastrar a URL do webhook em "Notificações > Webhooks".
# Sem ele o webhook recusa tudo — é o que impede alguém de forjar um
# "pagamento aprovado" e liberar o acesso de graça.
MP_WEBHOOK_SECRET=

# Ligue com 1 enquanto estiver testando com credenciais de teste. Faz o
# checkout não fixar o e-mail do pagador: o Mercado Pago recusa quando quem
# paga é a mesma conta que vende, e no teste isso acontece o tempo todo.
# Apague (ou deixe vazio) ao lançar em produção.
MP_MODO_TESTE=

# ---- Site ----
# URL pública, sem barra no fim. O Mercado Pago exige URLs absolutas para
# o retorno do checkout e para o webhook.
NEXT_PUBLIC_URL_SITE=https://seudominio.com.br

# ---- Preços, em centavos e inteiros ----
# 3490 = R$ 34,90 (preço) · 1490 = R$ 14,90 (comissão do afiliado)
NEXT_PUBLIC_PRECO_CENTAVOS=3490
COMISSAO_CENTAVOS=1490
